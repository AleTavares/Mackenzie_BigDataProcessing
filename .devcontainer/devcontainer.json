{
  "name": "Big Data Processing - Mackenzie MBA",
  "image": "quay.io/jupyter/pyspark-notebook:latest",
  "workspaceFolder": "/home/jovyan/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind",
  "containerEnv": {
    "JUPYTER_TOKEN": "",
    "JUPYTER_ENABLE_LAB": "yes"
  },
  "overrideCommand": false,
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [8888, 4040],
  "portsAttributes": {
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "openBrowser"
    },
    "4040": {
      "label": "Spark App UI",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "jupyter.notebookFileRoot": "/home/jovyan/work"
      }
    }
  },
  "postCreateCommand": "pip install delta-spark==3.2.0 2>/dev/null; echo '✅ Ambiente pronto!'",
  "remoteUser": "jovyan"
}
