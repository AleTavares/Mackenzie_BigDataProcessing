{
  "name": "Big Data Processing - Mackenzie MBA",
  "image": "quay.io/jupyter/pyspark-notebook:latest",
  "workspaceFolder": "/home/jovyan/work",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind",
  "containerEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-21-openjdk-amd64",
    "SPARK_HOME": "/usr/local/spark",
    "PYSPARK_PYTHON": "/opt/conda/bin/python",
    "PYSPARK_DRIVER_PYTHON": "/opt/conda/bin/python"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2"
    }
  },
  "forwardPorts": [4040],
  "portsAttributes": {
    "4040": {
      "label": "Spark App UI",
      "onAutoForward": "notify"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "jupyter.notebookFileRoot": "/home/jovyan/work",
        "notebook.formatOnSave.enabled": false,
        "editor.formatOnSave": true,
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      }
    }
  },
  "postCreateCommand": "pip install delta-spark==3.2.0 2>/dev/null; echo '✅ Ambiente pronto! Abra qualquer arquivo .ipynb para começar.'",
  "remoteUser": "jovyan"
}
